# ---------------------------------------------------------------------------
# Field Research Pipeline — environment
#
# Copy to `.env` and adjust. Every value below has a working default for the
# local demo stack, EXCEPT the optional provider credentials at the bottom.
# The system runs end-to-end with zero credentials using the mock providers.
# ---------------------------------------------------------------------------

# --- Runtime ---------------------------------------------------------------
NODE_ENV=development
LOG_LEVEL=info

# --- Datastores ------------------------------------------------------------
# Postgres holds all durable state (projects, runs, entities, evidence).
DATABASE_URL=postgres://frp:frp@localhost:5432/frp

# Redis backs the BullMQ job queue and the run-event pub/sub used by the SSE
# stream in the API.
REDIS_URL=redis://localhost:6379

# --- Services --------------------------------------------------------------
API_PORT=4000
API_HOST=0.0.0.0
# Comma-separated list of origins allowed to call the API.
API_CORS_ORIGIN=http://localhost:3000

# Worker concurrency = number of pipeline step attempts executed in parallel.
WORKER_CONCURRENCY=4

# Base URL the browser uses to reach the API.
NEXT_PUBLIC_API_URL=http://localhost:4000

# --- Multi-tenancy ---------------------------------------------------------
# The demo runs single-tenant. Every row is still scoped by tenant_id so that
# real isolation (RLS / per-tenant credentials) can be layered on later.
# See docs/security.md.
DEFAULT_TENANT_SLUG=demo
# Optional shared secret. When set, the API requires `x-api-key` on every
# /v1 request. Leave empty to disable auth for local development.
API_KEY=

# --- Provider selection ----------------------------------------------------
# Which adapter backs each stage of the pipeline.
#   research   : mock | llm
#   search     : mock | bright-data
#   extraction : mock | bright-data | llm
#   enrichment : mock | bright-data
# A pipeline configuration may override any of these per project.
PROVIDER_RESEARCH=mock
PROVIDER_SEARCH=mock
PROVIDER_EXTRACTION=mock
PROVIDER_ENRICHMENT=mock

# Mock provider tuning — makes the demo behave like a real, slow, occasionally
# failing network system instead of returning canned JSON instantly.
MOCK_SEED=field-research
MOCK_LATENCY_MS=350
MOCK_FAILURE_RATE=0.04

# --- Optional: Bright Data -------------------------------------------------
# Only required when PROVIDER_* is set to `bright-data`.
# https://docs.brightdata.com/
BRIGHT_DATA_API_KEY=
BRIGHT_DATA_SERP_ZONE=serp_api
BRIGHT_DATA_UNLOCKER_ZONE=web_unlocker

# --- Optional: LLM ---------------------------------------------------------
# Only required when PROVIDER_* is set to `llm`. Used for research planning,
# query generation and schema-constrained extraction. Never used to produce
# unvalidated free text that reaches the datastore.
ANTHROPIC_API_KEY=
LLM_MODEL=claude-opus-5

# --- Exports ---------------------------------------------------------------
# Directory the filesystem-backed export connectors write to.
#
# The API serves downloads from this directory and the worker writes to it, so
# both processes must resolve it to the SAME location. A relative path is
# resolved against each process's working directory: that is fine locally
# (`pnpm dev` runs both from the repository root) and in Docker (both services
# share /app plus a named volume). If you run them from different directories,
# use an absolute path.
EXPORT_DIR=./var/exports
