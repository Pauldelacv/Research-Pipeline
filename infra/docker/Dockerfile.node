# Shared image for the API and the worker.
#
# Both services are bundled with tsup, which inlines the workspace packages —
# so the runtime image needs no workspace resolution, no build ordering and no
# node_modules for internal packages.
FROM node:22-bookworm-slim AS base
ENV PNPM_HOME=/pnpm
ENV PATH=$PNPM_HOME:$PATH
RUN corepack enable
WORKDIR /app

# --- dependencies ---------------------------------------------------------
FROM base AS deps
COPY pnpm-lock.yaml pnpm-workspace.yaml package.json ./
COPY apps/api/package.json apps/api/
COPY apps/worker/package.json apps/worker/
COPY apps/web/package.json apps/web/
COPY packages/config/package.json packages/config/
COPY packages/connectors/package.json packages/connectors/
COPY packages/core/package.json packages/core/
COPY packages/db/package.json packages/db/
COPY packages/providers/package.json packages/providers/
COPY packages/queue/package.json packages/queue/
COPY packages/schemas/package.json packages/schemas/
COPY packages/scoring/package.json packages/scoring/
COPY examples/lead-generation/package.json examples/lead-generation/
COPY examples/competitive-intelligence/package.json examples/competitive-intelligence/
COPY examples/market-research/package.json examples/market-research/
RUN pnpm install --frozen-lockfile

# --- build ----------------------------------------------------------------
FROM deps AS build
ARG SERVICE=api
COPY tsconfig.base.json tsconfig.json ./
COPY packages ./packages
COPY examples ./examples
COPY apps/api ./apps/api
COPY apps/worker ./apps/worker
RUN pnpm --filter @frp/${SERVICE} build

# --- runtime --------------------------------------------------------------
FROM base AS runtime
ARG SERVICE=api
ENV NODE_ENV=production
ENV SERVICE=${SERVICE}

# tsup inlines the workspace packages, so only third-party modules and the
# generated migration SQL need to be present at runtime.
COPY --from=deps /app/node_modules ./node_modules
COPY --from=build /app/apps/${SERVICE}/dist ./dist
COPY packages/db/drizzle ./drizzle
ENV DRIZZLE_MIGRATIONS_DIR=/app/drizzle

RUN useradd --system --uid 10001 --create-home frp && chown -R frp:frp /app
USER frp

CMD ["node", "dist/index.js"]
