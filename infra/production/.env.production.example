# ---------------------------------------------------------------------------
# Production environment for infra/production/docker-compose.prod.yml
#
#   cp .env.production.example .env
#   chmod 600 .env
#
# Every value marked REQUIRED has no default and the stack refuses to start
# without it — a production deployment that boots on a guessed password is
# worse than one that does not boot. See docs/deployment.md.
# ---------------------------------------------------------------------------

# --- Public names (REQUIRED) ------------------------------------------------
# Both must already resolve to this host: Caddy proves control of them over
# ACME before it can issue a certificate.
APP_DOMAIN=research.example.com
API_DOMAIN=api.research.example.com
# Where Let's Encrypt sends expiry warnings if renewal ever stops working.
TLS_EMAIL=ops@example.com

# --- Datastore credentials (REQUIRED) ---------------------------------------
# Generate: openssl rand -base64 32
POSTGRES_PASSWORD=
POSTGRES_USER=frp
POSTGRES_DB=frp

# --- API authentication (REQUIRED in production) ----------------------------
# When set, every /v1 request needs an `x-api-key` header. There is no user
# authentication in this system (see docs/security.md), so this shared secret
# is the only thing between the internet and your data.
# Generate: openssl rand -hex 32
API_KEY=

# --- Runtime ----------------------------------------------------------------
LOG_LEVEL=info
# Step attempts executed in parallel *per worker container*. Total parallelism
# is WORKER_CONCURRENCY × WORKER_REPLICAS.
WORKER_CONCURRENCY=4
WORKER_REPLICAS=2
REDIS_MAXMEMORY=512mb

DEFAULT_TENANT_SLUG=production

# --- Provider selection -----------------------------------------------------
#   research   : mock | llm | openrouter
#   search     : mock | bright-data
#   extraction : mock | llm | openrouter | bright-data
#   enrichment : mock | bright-data
#
# Left on `mock`, a production deployment produces convincing synthetic data.
# That is right for a first boot and wrong for everything after it: switch
# these over before anyone treats a result as real.
PROVIDER_RESEARCH=mock
PROVIDER_SEARCH=mock
PROVIDER_EXTRACTION=mock
PROVIDER_ENRICHMENT=mock

# --- Optional: Anthropic ----------------------------------------------------
ANTHROPIC_API_KEY=
LLM_MODEL=claude-opus-5

# --- Optional: OpenRouter ---------------------------------------------------
# One key for many vendors; the model slug carries the vendor.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=anthropic/claude-sonnet-4.5
OPENROUTER_SITE_URL=
OPENROUTER_APP_NAME=field-research-pipeline

# --- Optional: cost accuracy ------------------------------------------------
# Published prices move and the built-in table goes stale. Set these to the
# real per-million-token prices of the model you run, and the run cost view
# stops being a guess. OpenRouter reports real prices and ignores them.
LLM_PRICE_INPUT_PER_MTOK=
LLM_PRICE_OUTPUT_PER_MTOK=

# --- Optional: Bright Data --------------------------------------------------
BRIGHT_DATA_API_KEY=
BRIGHT_DATA_SERP_ZONE=serp_api
BRIGHT_DATA_UNLOCKER_ZONE=web_unlocker

# --- Optional: export connectors --------------------------------------------
HUBSPOT_ACCESS_TOKEN=
NOTION_TOKEN=
SLACK_WEBHOOK_URL=
