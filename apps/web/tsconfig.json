{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "jsx": "preserve",
    "allowJs": true,
    "types": ["node"],
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./src/*"],
      "@frp/schemas": ["../../packages/schemas/src/index.ts"],
      "@frp/schemas/*": ["../../packages/schemas/src/*"]
    },
    "baseUrl": ".",
    "incremental": true,
    "esModuleInterop": true
  },
  "include": ["next-env.d.ts", "src/**/*.ts", "src/**/*.tsx", ".next/types/**/*.ts", "e2e/**/*.ts"],
  "exclude": ["node_modules"]
}
